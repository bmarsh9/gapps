# =============================================================================
# Masri Digital Compliance Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# On Cloudways: Set these in the application's environment variables.
# =============================================================================

# --- Application ---
APP_NAME=Masri Digital Compliance
APP_SUBTITLE=GRC Platform
VERSION=2.0.0
HOST_NAME=https://your-domain.com
SECRET_KEY=generate-a-strong-random-key-here
ENCRYPTION_KEY=generate-a-separate-encryption-key-here
FLASK_CONFIG=default

# --- Database (PostgreSQL) ---
POSTGRES_USER=db1
POSTGRES_PASSWORD=db1
POSTGRES_HOST=postgres
POSTGRES_DB=db1
SQLALCHEMY_DATABASE_URI=postgresql://db1:db1@postgres/db1

# --- Gunicorn / Server ---
APP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEP_ALIVE=60

# --- Email / SMTP ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Authentication ---
DEFAULT_EMAIL=admin@example.com
DEFAULT_PASSWORD=change-this-password
HELP_EMAIL=support@masridigital.com
ENABLE_SELF_REGISTRATION=false

# --- Google SSO ---
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft SSO ---
ENABLE_MICROSOFT_AUTH=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- File Storage ---
# Options: local, s3, gcs, azure
STORAGE_METHOD=local

# AWS S3
AWS_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1

# Google Cloud Storage
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# --- AI / LLM ---
LLM_ENABLED=false
# Options: claude, openai
LLM_PROVIDER=claude
LLM_MAX_TOKENS=2048

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- MCP Server ---
MCP_SERVER_URL=
MCP_SERVER_TOKEN=

# --- Database Reset (use with caution) ---
RESET_DB=no
# MIGRATE=yes
